rules_version = '2';

// Regras dos "Jogos sem anúncio".
// Cada jogador só lê e escreve as PRÓPRIAS coisas. Todo o resto fica trancado.
//
//   jogadores/{uid}                 → perfil do jogador (ex.: nome)
//   jogadores/{uid}/jogos/{jogo}    → progresso de cada jogo (ex.: "miaudoku", "mexe-mexe")
//   salas/{codigo}                  → sala do Mexe-Mexe online (o que todos da sala veem)
//   salas/{codigo}/maos/{uid}       → a mão de cada pessoa: SÓ a dona lê
//   salas/{codigo}/reveladas/{uid}  → a mão mostrada no fim da rodada
//   salas/{codigo}/pendentes/{uid}  → cartas compradas pelo jogo por quem demorou
service cloud.firestore {
  match /databases/{database}/documents {

    function ehDono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /jogadores/{uid} {
      allow read, write: if ehDono(uid);

      match /jogos/{jogo} {
        // nome do jogo: só letras minúsculas, números e hífen (até 30)
        allow read, delete: if ehDono(uid);
        allow create, update: if ehDono(uid)
          && jogo.matches('^[a-z0-9-]{1,30}$');
      }
    }

    // ----- Mexe-Mexe online -----
    // Jogo de família, mas as regras agora não deixam ninguém além do jogador da vez mexer na partida,
    // nem trocar o criador da sala, nem mexer em coisa de outra pessoa. Quem sabe o código (o link)
    // pode ver a sala e entrar; ninguém consegue listar as salas.
    // O que cada gravação do jogo faz está em mexe-mexe/src/online/sala.ts (cada "allow update" abaixo é uma delas).
    match /salas/{codigo} {
      function sala() { return get(/databases/$(database)/documents/salas/$(codigo)).data; }
      function logado() { return request.auth != null; }
      function membro() { return logado() && request.auth.uid in sala().uids; }

      function nomeOk(n) { return n is string && n.size() >= 1 && n.size() <= 16; }
      function configOk(c) {
        return c.keys().hasOnly(['curinga', 'modo', 'limiteSeg'])
          && c.curinga is bool
          && c.modo in ['casual', 'campeonato']
          && c.limiteSeg is int && c.limiteSeg >= 30 && c.limiteSeg <= 600;
      }
      function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function souMembro() { return request.auth.uid in resource.data.uids; }
      function souDono() { return request.auth.uid == resource.data.dono; }
      function proximaVersao() { return request.resource.data.versao == resource.data.versao + 1; }
      function souDaVez() { return resource.data.jogadores[resource.data.vez].uid == request.auth.uid; }
      // Tirar alguém / sair: a lista de jogadores não muda de tamanho, a versão sobe 1 (na espera fica igual),
      // a vez só muda se quem estava na vez saiu, e o jogo só acaba pela fase "fim".
      function saidaOk() {
        return request.resource.data.jogadores.size() == resource.data.jogadores.size()
          && request.resource.data.fase in [resource.data.fase, 'fim']
          && (resource.data.fase == 'espera' ? request.resource.data.versao == resource.data.versao : proximaVersao())
          && (request.resource.data.vez == resource.data.vez
              || request.resource.data.jogadores[resource.data.vez].get('removido', false) == true)
          && (request.resource.data.vezDesde == resource.data.vezDesde || request.resource.data.vez != resource.data.vez);
      }

      allow get: if logado();

      // Criar: só o criador, sala nova e vazia, no formato certo.
      allow create: if logado()
        && codigo.matches('^[A-Z2-9]{5}$')
        && request.resource.data.keys().hasOnly(['dono', 'fase', 'jogadores', 'uids', 'config', 'rodada', 'mesa', 'monte',
             'proximoId', 'cartas', 'vez', 'vezDesde', 'versao', 'motivoFim', 'quemBateu', 'resultado', 'totais', 'criadaEm'])
        && request.resource.data.dono == request.auth.uid
        && request.resource.data.uids == [request.auth.uid]
        && request.resource.data.jogadores.size() == 1
        && request.resource.data.jogadores[0].keys().hasOnly(['uid', 'nome'])
        && request.resource.data.jogadores[0].uid == request.auth.uid
        && nomeOk(request.resource.data.jogadores[0].nome)
        && request.resource.data.fase == 'espera'
        && request.resource.data.rodada == 0
        && request.resource.data.versao == 0
        && configOk(request.resource.data.config);

      allow update: if logado() && (
        // 1) Entrar na sala (ainda na espera, até 4): só acrescenta a si mesmo no fim das listas.
        (!souMembro()
          && resource.data.fase == 'espera'
          && resource.data.uids.size() < 4
          && mudou().hasOnly(['jogadores', 'uids', 'cartas', 'totais'])
          && request.resource.data.uids == resource.data.uids.concat([request.auth.uid])
          && request.resource.data.jogadores.size() == resource.data.jogadores.size() + 1
          && request.resource.data.jogadores[0:resource.data.jogadores.size()] == resource.data.jogadores
          && request.resource.data.jogadores[resource.data.jogadores.size()].keys().hasOnly(['uid', 'nome'])
          && request.resource.data.jogadores[resource.data.jogadores.size()].uid == request.auth.uid
          && nomeOk(request.resource.data.jogadores[resource.data.jogadores.size()].nome)
          && request.resource.data.cartas == resource.data.cartas.concat([0])
          && request.resource.data.totais == resource.data.totais.concat([0]))

        // 2) O criador muda as opções (só na espera).
        || (souDono() && resource.data.fase == 'espera'
          && mudou().hasOnly(['config'])
          && configOk(request.resource.data.config))

        // 3) O criador começa uma rodada (da espera ou depois do fim da anterior).
        || (souDono() && resource.data.fase in ['espera', 'fim']
          && resource.data.uids.size() >= 2
          && request.resource.data.fase == 'jogando'
          && request.resource.data.rodada == resource.data.rodada + 1
          && proximaVersao()
          && mudou().hasOnly(['fase', 'rodada', 'mesa', 'monte', 'proximoId', 'cartas', 'vez', 'vezDesde', 'versao',
               'motivoFim', 'quemBateu', 'resultado', 'totais']))

        // 4) Só quem está na vez joga (ou compra) e passa a vez; se acabou a rodada, vai para "contando".
        || (souMembro() && resource.data.fase == 'jogando' && souDaVez()
          && proximaVersao()
          && request.resource.data.fase in ['jogando', 'contando']
          && mudou().hasOnly(['fase', 'mesa', 'monte', 'proximoId', 'cartas', 'vez', 'vezDesde', 'versao', 'motivoFim', 'quemBateu']))

        // 5) Acabou o tempo de quem estava na vez: qualquer um da sala compra por ele e passa
        //    (a conta dá 30 s de folga porque o relógio de cada aparelho pode estar um pouco diferente).
        || (souMembro() && resource.data.fase == 'jogando'
          && request.time.toMillis() > resource.data.vezDesde + resource.data.config.limiteSeg * 1000 - 30000
          && proximaVersao()
          && mudou().hasOnly(['monte', 'cartas', 'vez', 'vezDesde', 'versao']))

        // 6) Todos mostraram a mão: qualquer um da sala conta os pontos.
        || (souMembro() && resource.data.fase == 'contando'
          && request.resource.data.fase == 'fim'
          && proximaVersao()
          && mudou().hasOnly(['fase', 'resultado', 'totais', 'versao']))

        // 7) O criador tira alguém da sala. Ninguém some da lista, só ganha a marca "removido"; a vez só muda
        //    se quem estava na vez foi o tirado, e o jogo só termina por falta de gente ("fim").
        || (souDono() && request.resource.data.dono == resource.data.dono
          && saidaOk()
          && mudou().hasOnly(['jogadores', 'cartas', 'uids', 'versao', 'fase', 'resultado', 'vez', 'vezDesde']))

        // 8) Sair da sala. Na espera a vaga some (e, se era o criador, passa para outro que está na sala).
        || (souMembro() && resource.data.fase == 'espera'
          && !(request.auth.uid in request.resource.data.uids)
          && request.resource.data.uids.size() == resource.data.uids.size() - 1
          && mudou().hasOnly(['jogadores', 'uids', 'cartas', 'totais', 'dono'])
          && (request.resource.data.dono == resource.data.dono
              || (souDono() && request.resource.data.dono in request.resource.data.uids)))
        //    No meio do jogo, a pessoa sai da partida (se estava na vez, a vez passa; só ela pode ser a tirada da vez).
        || (souMembro() && resource.data.fase in ['jogando', 'contando', 'fim']
          && request.resource.data.dono == resource.data.dono
          && saidaOk()
          && (request.resource.data.vez == resource.data.vez
              || resource.data.jogadores[resource.data.vez].uid == request.auth.uid)
          && mudou().hasOnly(['jogadores', 'cartas', 'versao', 'fase', 'resultado', 'vez', 'vezDesde'])));

      allow delete: if logado() && resource.data.dono == request.auth.uid;

      // A mão de cada pessoa: só a dona lê. Ela grava a própria; o criador grava as de todos ao distribuir.
      match /maos/{uid} {
        allow read: if logado() && request.auth.uid == uid;
        allow write: if membro()
          && (request.auth.uid == uid || sala().dono == request.auth.uid)
          && uid in sala().uids
          && request.resource.data.keys().hasOnly(['cartas'])
          && request.resource.data.cartas is string && request.resource.data.cartas.size() < 20000;
      }
      match /reveladas/{uid} {
        allow read: if membro();
        allow write: if membro() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['rodada', 'cartas'])
          && request.resource.data.cartas is string && request.resource.data.cartas.size() < 20000;
      }
      match /pendentes/{uid} {
        allow read: if membro();
        allow write: if membro() && uid in sala().uids
          && request.resource.data.keys().hasOnly(['cartas'])
          && request.resource.data.cartas is string && request.resource.data.cartas.size() < 20000;
      }
    }
  }
}
